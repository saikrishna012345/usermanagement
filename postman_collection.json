{
  "info": {
    "name": "Mobile Commerce Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health - Gateway",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/actuator/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"firstName\":\"Test\",\"lastName\":\"User\",\"email\":\"test@example.com\",\"mobileNumber\":\"9999999999\",\"password\":\"Test1234\"}"
        },
        "url": "{{gateway}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@example.com\",\"password\":\"Test1234\"}"
        },
        "url": "{{gateway}}/api/v1/auth/login"
      }
    },
    {
      "name": "Get User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{gateway}}/api/v1/users/1"
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Phone\",\"description\":\"Demo\",\"price\":999.99,\"stockQuantity\":10,\"categoryId\":1}"
        },
        "url": "{{gateway}}/api/v1/products"
      }
    },
    {
      "name": "Get Product",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/api/v1/products/1"
      }
    },
    {
      "name": "Create Order - Feign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":1,\"items\":[{\"productId\":1,\"quantity\":1}]}"
        },
        "url": "{{gateway}}/api/v1/orders"
      }
    },
    {
      "name": "Get Order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{gateway}}/api/v1/orders/1"
      }
    }
  ]
}